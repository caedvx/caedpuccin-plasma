* {
  bg:      rgba(10, 10, 10, 88%);
  surface: rgba(255, 255, 255, 4.5%);
  border:  rgba(255, 255, 255, 11%);
  text:    #ffffff;
  dim:     rgba(255, 255, 255, 56%);
  faint:   rgba(255, 255, 255, 35%);

  font: "Geist 11";
  background-color: transparent;
  text-color: @text;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 560px;
  background-color: @bg;
  border: 1px;
  border-color: @border;
  border-radius: 14px;
  padding: 18px;
}

mainbox { spacing: 14px; children: [ inputbar, listview ]; }

inputbar {
  spacing: 12px;
  padding: 12px 14px;
  background-color: @surface;
  border: 1px;
  border-color: @border;
  border-radius: 10px;
  children: [ prompt, entry ];
}
prompt {
  font: "Geist Mono Medium 9";
  text-color: @faint;
  vertical-align: 0.5;
}
entry {
  placeholder: "Search";
  placeholder-color: @faint;
  cursor-color: @text;
  vertical-align: 0.5;
}

listview { lines: 8; columns: 1; fixed-height: true; spacing: 2px; scrollbar: false; }

element { padding: 9px 12px; spacing: 12px; border-radius: 8px; }
element-icon { size: 20px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
element normal.normal, element alternate.normal { text-color: @dim; }
element selected.normal { background-color: #ffffff; text-color: #000000; }
element normal.urgent, element alternate.urgent { text-color: #f87171; }
element selected.urgent { background-color: #f87171; text-color: #000000; }
element normal.active, element alternate.active { text-color: @text; }
element selected.active { background-color: #f5f5f5; text-color: #000000; }
