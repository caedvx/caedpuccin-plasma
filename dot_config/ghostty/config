# Theme tied directly to the flagship Catppuccin Mocha palette
theme = "Catppuccin Mocha"
font-family = "JetBrainsMono Nerd Font"
font-size = 9

# Window Layout
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.65
background-blur-radius = 12

# Aesthetics & Cursor
cursor-style = block
cursor-color = #f5c2e7
cursor-text = #1e1e2e
