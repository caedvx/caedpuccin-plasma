[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (14, 56)
    width = (280, 380)
    notification_limit = 5
    gap_size = 8
    padding = 14
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#ffffff1c"
    corner_radius = 12
    separator_color = frame
    font = Geist 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    highlight = "#ffffff"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#000000e0"
    foreground = "#a3a3a3"
    timeout = 4

[urgency_normal]
    background = "#000000e0"
    foreground = "#ffffff"
    timeout = 6

[urgency_critical]
    background = "#000000f0"
    foreground = "#ffffff"
    frame_color = "#f87171"
    highlight = "#f87171"
    timeout = 0
